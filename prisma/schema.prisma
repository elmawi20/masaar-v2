// Masaar Clinic System — Prisma Schema
// Specification Reference: docs/FEATURES-v2.2.md
// Stage 1 Design — Database Slice A: Clinic, Staff & Auth
// Stage 1 Design — Database Slice B: Patients & Documents
// Stage 1 Design — Database Slice C: Scheduling
// Stage 1 Design — Database Slice D: Packages & Money

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// Enums for Slice A
// ============================================================================

enum Role {
  OWNER
  MANAGER
  RECEPTIONIST
  PHYSIOTHERAPIST
  NUTRITIONIST
}

enum PreferredLanguage {
  AR
  EN
}

enum OtpStatus {
  NOT_SET
  PENDING
  ACTIVE
}

enum CommissionType {
  PERCENT
  FIXED_PER_SESSION
  NONE
}

enum SessionCategory {
  PHYSIOTHERAPY
  NUTRITION
  CONSULTANT_ASSESSMENT
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ============================================================================
// Enums for Slice B (Patients & Documents)
// ============================================================================

enum Gender {
  MALE
  FEMALE
}

enum PatientStatus {
  LEAD
  ACTIVE
  DISCHARGED
}

enum GuardianRelation {
  FATHER
  MOTHER
  SON
  DAUGHTER
  SPOUSE
  OTHER
}

enum ReferralSource {
  DOCTOR
  FACEBOOK
  INSTAGRAM
  GOOGLE
  FRIEND_FAMILY
  WALK_IN
  OTHER
}

enum DocumentCategory {
  PRESCRIPTION
  X_RAY
  MRI
  LAB_REPORT
  REFERRAL
  ID_ADMINISTRATIVE
  PAYMENT_PROOF
  OTHER
}

// ============================================================================
// Enums for Slice C (Scheduling)
// ============================================================================

enum AppointmentStatus {
  SCHEDULED
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
  WAITLISTED
}

enum ReminderChannel {
  WHATSAPP
  SMS
  MANUAL_CALL
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
  READ
}

enum NotificationType {
  PATIENT_CHECKED_IN
  PATIENT_LATE_ARRIVAL
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  PACKAGE_LOW_SESSIONS
  PACKAGE_EXPIRING_SOON
  SYSTEM_ALERT
}

// ============================================================================
// Enums for Slice D (Packages & Money)
// ============================================================================

enum PackageStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum ChargeStatus {
  ACTIVE
  CANCELLED
}

enum PaymentMethod {
  CASH
  INSTAPAY
  VODAFONE_CASH
  CARD
  FAWRY
  BANK_TRANSFER
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

// ============================================================================
// 1. Clinic Settings & Schedules
// ============================================================================

model ClinicSetting {
  id                       String   @id @default(uuid())
  nameAr                   String   @map("name_ar") @db.VarChar(120)
  nameEn                   String   @map("name_en") @db.VarChar(120)
  addressAr                String?  @map("address_ar") @db.Text
  addressEn                String?  @map("address_en") @db.Text
  phone                    String   @db.VarChar(30)
  logoUrl                  String?  @map("logo_url") @db.Text
  timezone                 String   @default("Africa/Cairo") @db.VarChar(50)
  defaultPackageExpiryDays Int      @default(60) @map("default_package_expiry_days")
  doctorDailySoftLimit     Int      @default(10) @map("doctor_daily_soft_limit")
  receiptPrefix            String   @default("INV") @map("receipt_prefix") @db.VarChar(10)
  noteEditWindowHours      Int      @default(24) @map("note_edit_window_hours")
  updatedByUserId          String?  @map("updated_by_user_id")
  updatedByUser            User?    @relation("ClinicSettingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("clinic_settings")
}

model ClinicOpeningHour {
  id              String   @id @default(uuid())
  dayOfWeek       Int      @map("day_of_week") // 0 = Saturday, 1 = Sunday ... 6 = Friday
  isOpen          Boolean  @default(true) @map("is_open")
  openTime        String   @default("09:00") @map("open_time") @db.VarChar(5) // HH:mm (24h)
  closeTime       String   @default("21:00") @map("close_time") @db.VarChar(5) // HH:mm (24h)
  updatedByUserId String?  @map("updated_by_user_id")
  updatedByUser   User?    @relation("OpeningHourUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([dayOfWeek])
  @@map("clinic_opening_hours")
}

model ClinicClosure {
  id              String   @id @default(uuid())
  closureDate     DateTime @map("closure_date") @db.Date // Specific closure day
  reasonAr        String   @map("reason_ar") @db.VarChar(150)
  reasonEn        String   @map("reason_en") @db.VarChar(150)
  isActive        Boolean  @default(true) @map("is_active")
  createdByUserId String?  @map("created_by_user_id")
  createdByUser   User?    @relation("ClinicClosureCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([closureDate])
  @@map("clinic_closures")
}

// ============================================================================
// 2. Facilities & Session Types
// ============================================================================

model Room {
  id              String   @id @default(uuid())
  nameAr          String   @map("name_ar") @db.VarChar(100)
  nameEn          String   @map("name_en") @db.VarChar(100)
  isActive        Boolean  @default(true) @map("is_active")
  createdByUserId String?  @map("created_by_user_id")
  createdByUser   User?    @relation("RoomCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  beds              Bed[]
  appointments      Appointment[]
  appointmentSeries AppointmentSeries[]

  @@map("rooms")
}

model Bed {
  id              String   @id @default(uuid())
  roomId          String   @map("room_id")
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  name            String   @db.VarChar(100)
  isActive        Boolean  @default(true) @map("is_active")
  createdByUserId String?  @map("created_by_user_id")
  createdByUser   User?    @relation("BedCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  appointments      Appointment[]
  appointmentSeries AppointmentSeries[]

  @@unique([roomId, name])
  @@map("beds")
}

model SessionType {
  id                     String          @id @default(uuid())
  code                   String          @unique @db.VarChar(50) // PHYSIOTHERAPY, NUTRITION, ASSESSMENT
  category               SessionCategory @default(PHYSIOTHERAPY)
  nameAr                 String          @map("name_ar") @db.VarChar(120)
  nameEn                 String          @map("name_en") @db.VarChar(120)
  defaultDurationMinutes Int             @default(45) @map("default_duration_minutes") // 15..180 steps of 15
  defaultPricePiasters   Int             @map("default_price_piasters") // Money in integer piasters (100 = 1 EGP)
  isActive               Boolean         @default(true) @map("is_active")
  createdByUserId        String?         @map("created_by_user_id")
  createdByUser          User?           @relation("SessionTypeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  appointments      Appointment[]
  appointmentSeries AppointmentSeries[]
  packages          Package[]

  @@map("session_types")
}

// ============================================================================
// 3. Users, Staff Rosters & Leaves
// ============================================================================

model User {
  id                           String            @id @default(uuid())
  email                        String            @unique @db.VarChar(255) // Case-insensitive unique via citext / index
  passwordHash                 String            @map("password_hash") @db.VarChar(255)
  fullName                     String            @map("full_name") @db.VarChar(120)
  phone                        String            @db.VarChar(30)
  jobTitle                     String            @map("job_title") @db.VarChar(100)
  role                         Role
  preferredLanguage            PreferredLanguage @default(AR) @map("preferred_language")
  isActive                     Boolean           @default(true) @map("is_active")
  deactivatedAt                DateTime?         @map("deactivated_at")
  mustChangePassword           Boolean           @default(false) @map("must_change_password")
  failedLoginCount             Int               @default(0) @map("failed_login_count")
  lockedUntil                  DateTime?         @map("locked_until")
  otpStatus                    OtpStatus         @default(NOT_SET) @map("otp_status")
  canAssess                    Boolean           @default(false) @map("can_assess")
  commissionType               CommissionType    @default(NONE) @map("commission_type")
  commissionPercentBasisPoints Int               @default(0) @map("commission_percent_basis_points") // 2500 = 25.00%
  commissionFixedPiasters      Int               @default(0) @map("commission_fixed_piasters") // Fixed amount in piasters
  createdByUserId              String?           @map("created_by_user_id")
  createdByUser                User?             @relation("UserCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt                    DateTime          @default(now()) @map("created_at")
  updatedAt                    DateTime          @updatedAt @map("updated_at")

  // Staff Schedule & Leave Relations
  schedules StaffSchedule[]
  leaves    StaffLeave[]

  // Auth & Security Relations
  sessions           UserSession[]
  otpSecret          OtpSecret?
  backupCodes        OtpBackupCode[]
  trustedDevices     TrustedDevice[]
  passwordResetCodes PasswordResetCode[]

  // Administrative Audit & Authoring Relations
  createdUsers            User[]              @relation("UserCreatedBy")
  updatedClinicSettings   ClinicSetting[]     @relation("ClinicSettingUpdatedBy")
  updatedOpeningHours     ClinicOpeningHour[] @relation("OpeningHourUpdatedBy")
  createdClosures         ClinicClosure[]     @relation("ClinicClosureCreatedBy")
  createdRooms            Room[]              @relation("RoomCreatedBy")
  createdBeds             Bed[]               @relation("BedCreatedBy")
  createdSessionTypes     SessionType[]       @relation("SessionTypeCreatedBy")
  updatedMessageTemplates MessageTemplate[]   @relation("MessageTemplateUpdatedBy")
  approvedLeaves          StaffLeave[]        @relation("StaffLeaveApprovedBy")
  auditLogs               AuditLog[]

  // Patient & Clinical Relations (Slice B)
  assignedPhysioPatients    Patient[]           @relation("AssignedPhysiotherapist")
  assignedNutritionPatients Patient[]           @relation("AssignedNutritionist")
  dischargedPatients        Patient[]           @relation("PatientDischargedBy")
  createdPatients           Patient[]           @relation("PatientCreatedBy")
  updatedPatients           Patient[]           @relation("PatientUpdatedBy")
  diagnosesAuthored         PatientDiagnosis[]  @relation("DiagnosedByUser")
  createdDiagnoses          PatientDiagnosis[]  @relation("PatientDiagnosisCreatedBy")
  updatedDiagnoses          PatientDiagnosis[]  @relation("PatientDiagnosisUpdatedBy")
  documentsUploaded         PatientDocument[]   @relation("DocumentUploadedBy")
  createdDocuments          PatientDocument[]   @relation("PatientDocumentCreatedBy")
  updatedDocuments          PatientDocument[]   @relation("PatientDocumentUpdatedBy")
  documentViews             DocumentViewLog[]   @relation("DocumentViewedBy")
  coveringAccessGrants      CoveringAccessLog[] @relation("CoveringAccessClinician")

  // Scheduling Relations (Slice C)
  clinicianAppointments Appointment[]              @relation("AppointmentClinician")
  createdAppointments   Appointment[]              @relation("AppointmentCreatedBy")
  updatedAppointments   Appointment[]              @relation("AppointmentUpdatedBy")
  clinicianSeries       AppointmentSeries[]        @relation("SeriesClinician")
  createdSeries         AppointmentSeries[]        @relation("SeriesCreatedBy")
  statusChangesAuthored AppointmentStatusHistory[] @relation("StatusChangedBy")
  remindersSent         AppointmentReminder[]      @relation("ReminderSentBy")
  receivedNotifications InAppNotification[]        @relation("ReceivedNotifications")

  // Packages & Billing Relations (Slice D)
  packagesCreated       Package[]            @relation("PackageCreatedBy")
  packagesUpdated       Package[]            @relation("PackageUpdatedBy")
  packageExtensions     PackageExtension[]   @relation("PackageExtendedBy")
  chargesCreated        Charge[]             @relation("ChargeCreatedBy")
  paymentsCollected     Payment[]            @relation("PaymentCollectedBy")
  paymentsVoided        Payment[]            @relation("PaymentVoidedBy")
  refundsHandedOut      Refund[]             @relation("RefundHandedOutBy")
  refundsApproved       Refund[]             @relation("RefundApprovedBy")
  writeOffsApproved     WriteOff[]           @relation("WriteOffApprovedBy")
  priceChangesAuthored  PriceChangeHistory[] @relation("PriceChangedBy")
  cashClosingsConducted CashClosing[]        @relation("CashierClosings")
  cashClosingsWitnessed CashClosing[]        @relation("WitnessClosings")

  @@map("users")
}

model StaffSchedule {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek   Int      @map("day_of_week") // 0 = Saturday ... 6 = Friday
  shiftNumber Int      @map("shift_number") // 1 or 2 (up to 2 shifts per day)
  isWorking   Boolean  @default(true) @map("is_working")
  startTime   String   @map("start_time") @db.VarChar(5) // HH:mm (24h)
  endTime     String   @map("end_time") @db.VarChar(5) // HH:mm (24h)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, dayOfWeek, shiftNumber])
  @@map("staff_schedules")
}

model StaffLeave {
  id               String      @id @default(uuid())
  userId           String      @map("user_id")
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate        DateTime    @map("start_date") @db.Date
  endDate          DateTime    @map("end_date") @db.Date
  leaveType        LeaveType   @map("leave_type")
  status           LeaveStatus @default(APPROVED)
  note             String?     @db.Text
  approvedByUserId String?     @map("approved_by_user_id")
  approvedByUser   User?       @relation("StaffLeaveApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@index([userId, startDate, endDate])
  @@map("staff_leaves")
}

// ============================================================================
// 4. Authentication, Sessions & Security Secrets
// ============================================================================

model LoginAttempt {
  id            String   @id @default(uuid())
  email         String   @db.VarChar(255)
  ipAddress     String   @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.Text
  isSuccessful  Boolean  @map("is_successful")
  failureReason String?  @map("failure_reason") @db.VarChar(100)
  attemptedAt   DateTime @default(now()) @map("attempted_at")

  @@index([email, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@map("login_attempts")
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique @map("token_hash") @db.VarChar(255) // Session token stored strictly as hash
  ipAddress    String    @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.Text
  lastActiveAt DateTime  @default(now()) @map("last_active_at") // Checked for 15-min idle lock
  expiresAt    DateTime  @map("expires_at") // Absolute 12-hour maximum
  isRevoked    Boolean   @default(false) @map("is_revoked")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  // Session Covering Access (Slice B)
  coveringAccessLogs CoveringAccessLog[] @relation("SessionCoveringAccess")

  @@index([userId, isRevoked])
  @@map("user_sessions")
}

model OtpSecret {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted   String    @map("secret_encrypted") @db.Text // AES-256-GCM ciphertext, key in .env only
  verifiedAt        DateTime? @map("verified_at")
  failedOtpAttempts Int       @default(0) @map("failed_otp_attempts")
  otpLockedUntil    DateTime? @map("otp_locked_until")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("otp_secrets")
}

model OtpBackupCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash") @db.VarChar(255) // 1 of 10 backup codes, stored strictly as hash
  isUsed    Boolean   @default(false) @map("is_used")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, isUsed])
  @@map("otp_backup_codes")
}

model TrustedDevice {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceTokenHash String    @unique @map("device_token_hash") @db.VarChar(255) // Token stored strictly as hash
  deviceName      String    @map("device_name") @db.VarChar(120)
  ipAddress       String    @map("ip_address") @db.VarChar(45)
  userAgent       String?   @map("user_agent") @db.Text
  expiresAt       DateTime  @map("expires_at") // 30 days from creation
  isRevoked       Boolean   @default(false) @map("is_revoked")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([userId, isRevoked])
  @@map("trusted_devices")
}

model PasswordResetCode {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash      String    @map("code_hash") @db.VarChar(255) // 6-digit email reset code, stored as hash
  expiresAt     DateTime  @map("expires_at") // 10 minutes validity
  attemptsCount Int       @default(0) @map("attempts_count") // Max 5 attempts
  isUsed        Boolean   @default(false) @map("is_used") // Single use only
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId, isUsed])
  @@map("password_reset_codes")
}

// ============================================================================
// 5. Settings: WhatsApp & Notification Templates
// ============================================================================

model MessageTemplate {
  id              String            @id @default(uuid())
  key             String            @db.VarChar(50) // WELCOME, REMINDER, RESCHEDULE, etc.
  language        PreferredLanguage @map("language")
  templateText    String            @map("template_text") @db.Text
  updatedByUserId String?           @map("updated_by_user_id")
  updatedByUser   User?             @relation("MessageTemplateUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@unique([key, language])
  @@map("message_templates")
}

// ============================================================================
// 6. Immutable Audit Trail
// ============================================================================

model AuditLog {
  id          String   @id @default(uuid())
  timestamp   DateTime @default(now()) @map("created_at")
  userId      String?  @map("user_id") // Nullable for unauthenticated/system actions
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull) // Never cascade delete
  userRole    String?  @map("user_role") @db.VarChar(50)
  action      String   @db.VarChar(100) // CREATE, UPDATE, STATUS_CHANGE, LOGIN, etc.
  entityType  String   @map("entity_type") @db.VarChar(100) // USER, APPOINTMENT, SETTING, etc.
  entityId    String?  @map("entity_id") @db.VarChar(100)
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  reason      String?  @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text

  @@index([userId, timestamp])
  @@index([entityType, entityId])
  @@index([action, timestamp])
  @@map("audit_logs")
}

// ============================================================================
// 7. Patients & Clinical Records (Slice B)
// ============================================================================

model Patient {
  id                    String            @id @default(uuid())
  fileNumber            Int               @unique @default(autoincrement()) @map("file_number") // Sequential file number M-0001
  fullName              String            @map("full_name") @db.VarChar(120) // R-4.1-1
  mobilePhone           String?           @map("mobile_phone") @db.VarChar(15) // Egyptian 01XXXXXXXXX, unique for adults via partial index (R-4.1-2, R-4.2-2)
  isDependent           Boolean           @default(false) @map("is_dependent") // Uses guardian phone (R-4.1-3)
  guardianName          String?           @map("guardian_name") @db.VarChar(120) // R-4.1-4
  guardianRelation      GuardianRelation? @map("guardian_relation") // R-4.1-5
  guardianPhone         String?           @map("guardian_phone") @db.VarChar(15) // Normalized 01XXXXXXXXX, can repeat (R-4.1-6)
  whatsappPhone         String?           @map("whatsapp_phone") @db.VarChar(15) // Defaults to mobilePhone or guardianPhone (R-4.1-7)
  dateOfBirth           DateTime          @map("date_of_birth") @db.Date // Age dynamically calculated per calculations.md (R-4.1-8)
  gender                Gender // R-4.1-9
  address               String?           @db.Text // R-4.1-10
  emergencyContactName  String?           @map("emergency_contact_name") @db.VarChar(120) // R-4.1-11
  emergencyContactPhone String?           @map("emergency_contact_phone") @db.VarChar(30) // R-4.1-11
  preferredLanguage     PreferredLanguage @default(AR) @map("preferred_language") // R-4.1-12
  referralSource        ReferralSource    @map("referral_source") // R-4.1-13
  referralSourceDetails String?           @map("referral_source_details") @db.VarChar(255) // R-4.1-13
  referringDoctor       String?           @map("referring_doctor") @db.VarChar(120) // R-4.1-14
  initialComplaint      String            @map("initial_complaint") @db.Text // Receptionist notes, NOT a diagnosis (R-4.1-15)

  // Medical Alerts (R-4.1-16)
  hasDiabetes        Boolean @default(false) @map("has_diabetes")
  hasPacemaker       Boolean @default(false) @map("has_pacemaker")
  hasHypertension    Boolean @default(false) @map("has_hypertension")
  hasOsteoporosis    Boolean @default(false) @map("has_osteoporosis")
  hasFallRisk        Boolean @default(false) @map("has_fall_risk")
  isPregnant         Boolean @default(false) @map("is_pregnant")
  medicalAlertsNotes String? @map("medical_alerts_notes") @db.Text // Clinicians only; receptionist sees "has alerts"

  // Assigned Clinicians (R-4.1-17, R-4.1-18)
  assignedPhysiotherapistId String? @map("assigned_physiotherapist_id")
  assignedPhysiotherapist   User?   @relation("AssignedPhysiotherapist", fields: [assignedPhysiotherapistId], references: [id], onDelete: SetNull)
  assignedNutritionistId    String? @map("assigned_nutritionist_id")
  assignedNutritionist      User?   @relation("AssignedNutritionist", fields: [assignedNutritionistId], references: [id], onDelete: SetNull)

  // Patient Status & Consents (R-4.1-19, R-4.1-20, R-4.1-21, R-4.2-6)
  status             PatientStatus @default(LEAD)
  dataConsent        Boolean       @default(false) @map("data_consent")
  dataConsentDate    DateTime?     @map("data_consent_date")
  whatsappConsent    Boolean       @default(true) @map("whatsapp_consent")
  receptionNotes     String?       @map("reception_notes") @db.Text
  firstVisitAt       DateTime?     @map("first_visit_at")
  dischargedAt       DateTime?     @map("discharged_at")
  dischargedByUserId String?       @map("discharged_by_user_id")
  dischargedByUser   User?         @relation("PatientDischargedBy", fields: [dischargedByUserId], references: [id], onDelete: SetNull)
  dischargeReason    String?       @map("discharge_reason") @db.Text

  // Audit Fields (R-0-2, R-13-1)
  createdByUserId String?  @map("created_by_user_id")
  createdByUser   User?    @relation("PatientCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String?  @map("updated_by_user_id")
  updatedByUser   User?    @relation("PatientUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Slice B Relations
  diagnoses          PatientDiagnosis[]
  documents          PatientDocument[]
  coveringAccessLogs CoveringAccessLog[]

  // Slice C Relations
  appointments      Appointment[]
  appointmentSeries AppointmentSeries[]
  notifications     InAppNotification[]

  // Slice D Relations
  packages Package[]
  charges  Charge[]

  @@index([fullName])
  @@index([mobilePhone])
  @@index([guardianPhone])
  @@index([status])
  @@index([assignedPhysiotherapistId])
  @@index([assignedNutritionistId])
  @@map("patients")
}

model PatientDiagnosis {
  id                String    @id @default(uuid())
  patientId         String    @map("patient_id")
  patient           Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  diagnosisText     String    @map("diagnosis_text") @db.Text // R-4.1-22, R-9.3-1
  diagnosedByUserId String    @map("diagnosed_by_user_id")
  diagnosedByUser   User      @relation("DiagnosedByUser", fields: [diagnosedByUserId], references: [id], onDelete: Restrict)
  diagnosedAt       DateTime  @default(now()) @map("diagnosed_at")
  isActive          Boolean   @default(true) @map("is_active")
  resolvedAt        DateTime? @map("resolved_at")
  notes             String?   @db.Text
  createdByUserId   String?   @map("created_by_user_id")
  createdByUser     User?     @relation("PatientDiagnosisCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId   String?   @map("updated_by_user_id")
  updatedByUser     User?     @relation("PatientDiagnosisUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([patientId, isActive])
  @@index([diagnosedByUserId])
  @@map("patient_diagnoses")
}

model PatientDocument {
  id               String           @id @default(uuid())
  patientId        String           @map("patient_id")
  patient          Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  category         DocumentCategory // R-9.5-1
  title            String           @db.VarChar(150)
  fileKey          String           @map("file_key") @db.VarChar(500) // Private path outside web root (R-9.5-1)
  fileName         String           @map("file_name") @db.VarChar(255)
  fileSizeBytes    Int              @map("file_size_bytes") // Max 10MB (10,485,760 bytes)
  mimeType         String           @map("mime_type") @db.VarChar(100) // application/pdf, image/jpeg, etc.
  isMedical        Boolean          @default(true) @map("is_medical") // False for ID_ADMINISTRATIVE, PAYMENT_PROOF
  uploadedByUserId String           @map("uploaded_by_user_id") // R-1.1-3
  uploadedByUser   User             @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  isActive         Boolean          @default(true) @map("is_active") // Soft-delete (R-0-3)
  voidedAt         DateTime?        @map("voided_at")
  voidReason       String?          @map("void_reason") @db.Text
  createdByUserId  String?          @map("created_by_user_id")
  createdByUser    User?            @relation("PatientDocumentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId  String?          @map("updated_by_user_id")
  updatedByUser    User?            @relation("PatientDocumentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  viewLogs DocumentViewLog[]

  @@index([patientId, category])
  @@index([uploadedByUserId])
  @@index([isActive])
  @@map("patient_documents")
}

model DocumentViewLog {
  id               String          @id @default(uuid())
  documentId       String          @map("document_id")
  document         PatientDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  viewedByUserId   String          @map("viewed_by_user_id")
  viewedByUser     User            @relation("DocumentViewedBy", fields: [viewedByUserId], references: [id], onDelete: Restrict)
  viewedAt         DateTime        @default(now()) @map("viewed_at") // R-9.5-1, R-13-1
  watermarkApplied Boolean         @default(true) @map("watermark_applied") // Viewer name + timestamp (R-9.5-1)
  ipAddress        String          @map("ip_address") @db.VarChar(45)
  userAgent        String?         @map("user_agent") @db.Text

  @@index([documentId, viewedAt])
  @@index([viewedByUserId, viewedAt])
  @@map("document_view_logs")
}

model CoveringAccessLog {
  id          String       @id @default(uuid())
  patientId   String       @map("patient_id")
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinicianId String       @map("clinician_id")
  clinician   User         @relation("CoveringAccessClinician", fields: [clinicianId], references: [id], onDelete: Restrict)
  sessionId   String?      @map("session_id") // Session-bound covering access (R-1.1-21, DEC-013)
  session     UserSession? @relation("SessionCoveringAccess", fields: [sessionId], references: [id], onDelete: SetNull)
  reason      String       @db.Text // Mandatory written clinical justification (R-1.1-21)
  grantedAt   DateTime     @default(now()) @map("granted_at")
  expiresAt   DateTime     @map("expires_at") // Max 12 hours or logout
  ipAddress   String       @map("ip_address") @db.VarChar(45)
  userAgent   String?      @map("user_agent") @db.Text

  @@index([clinicianId, patientId, grantedAt])
  @@index([sessionId])
  @@map("covering_access_logs")
}

// ============================================================================
// 8. Scheduling (Slice C)
// ============================================================================

model Appointment {
  id                 String             @id @default(uuid())
  patientId          String             @map("patient_id")
  patient            Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  sessionTypeId      String             @map("session_type_id")
  sessionType        SessionType        @relation(fields: [sessionTypeId], references: [id], onDelete: Restrict)
  clinicianId        String             @map("clinician_id")
  clinician          User               @relation("AppointmentClinician", fields: [clinicianId], references: [id], onDelete: Restrict)
  roomId             String             @map("room_id")
  room               Room               @relation(fields: [roomId], references: [id], onDelete: Restrict)
  bedId              String             @map("bed_id")
  bed                Bed                @relation(fields: [bedId], references: [id], onDelete: Restrict)
  seriesId           String?            @map("series_id")
  series             AppointmentSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  packageId          String?            @map("package_id")
  package            Package?           @relation(fields: [packageId], references: [id], onDelete: SetNull)
  appointmentDate    DateTime           @map("appointment_date") @db.Date // Clinic-local calendar date (Africa/Cairo)
  startTime          String             @map("start_time") @db.VarChar(5) // HH:mm (24h)
  endTime            String             @map("end_time") @db.VarChar(5) // HH:mm (24h)
  startsAt           DateTime           @map("starts_at") // UTC DateTime for calendar range & btree_gist
  endsAt             DateTime           @map("ends_at") // UTC DateTime for calendar range & btree_gist
  durationMinutes    Int                @default(45) @map("duration_minutes") // 15..180 steps of 15 (R-5.1-1)
  pricePiasters      Int?               @map("price_piasters") // Money in integer piasters, nullable if covered by package (R-0-4, R-5.1-1)
  status             AppointmentStatus  @default(SCHEDULED)
  notesForReception  String?            @map("notes_for_reception") @db.Text
  checkInAt          DateTime?          @map("check_in_at")
  lateMinutes        Int?               @map("late_minutes") // Stored upon check-in if late (R-14-2)
  completedAt        DateTime?          @map("completed_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  cancellationReason String?            @map("cancellation_reason") @db.Text
  noShowAt           DateTime?          @map("no_show_at")
  noShowReason       String?            @map("no_show_reason") @db.Text
  createdByUserId    String?            @map("created_by_user_id")
  createdByUser      User?              @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId    String?            @map("updated_by_user_id")
  updatedByUser      User?              @relation("AppointmentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  statusHistory AppointmentStatusHistory[]
  reminders     AppointmentReminder[]
  notifications InAppNotification[]
  charges       Charge[]
  priceChanges  PriceChangeHistory[]

  @@index([patientId, appointmentDate])
  @@index([clinicianId, startsAt, endsAt])
  @@index([bedId, startsAt, endsAt])
  @@index([appointmentDate, status])
  @@index([seriesId])
  @@map("appointments")
}

model AppointmentSeries {
  id              String      @id @default(uuid())
  patientId       String      @map("patient_id")
  patient         Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sessionTypeId   String      @map("session_type_id")
  sessionType     SessionType @relation(fields: [sessionTypeId], references: [id], onDelete: Restrict)
  clinicianId     String      @map("clinician_id")
  clinician       User        @relation("SeriesClinician", fields: [clinicianId], references: [id], onDelete: Restrict)
  roomId          String      @map("room_id")
  room            Room        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  bedId           String      @map("bed_id")
  bed             Bed         @relation(fields: [bedId], references: [id], onDelete: Restrict)
  daysOfWeek      Int[]       @map("days_of_week") // Array of integers 0..6 (0=Sat ... 6=Fri)
  startTime       String      @map("start_time") @db.VarChar(5) // HH:mm (24h)
  durationMinutes Int         @default(45) @map("duration_minutes")
  totalSessions   Int         @map("total_sessions")
  startDate       DateTime    @map("start_date") @db.Date
  endDate         DateTime?   @map("end_date") @db.Date
  isActive        Boolean     @default(true) @map("is_active")
  createdByUserId String?     @map("created_by_user_id")
  createdByUser   User?       @relation("SeriesCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  appointments Appointment[]

  @@index([patientId])
  @@index([clinicianId])
  @@map("appointment_series")
}

model AppointmentStatusHistory {
  id              String             @id @default(uuid())
  appointmentId   String             @map("appointment_id")
  appointment     Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  fromStatus      AppointmentStatus? @map("from_status")
  toStatus        AppointmentStatus  @map("to_status")
  changedByUserId String?            @map("changed_by_user_id")
  changedByUser   User?              @relation("StatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)
  reason          String?            @db.Text
  transitionedAt  DateTime           @default(now()) @map("transitioned_at")
  ipAddress       String?            @map("ip_address") @db.VarChar(45)
  userAgent       String?            @map("user_agent") @db.Text

  @@index([appointmentId, transitionedAt])
  @@index([changedByUserId, transitionedAt])
  @@map("appointment_status_history")
}

model AppointmentReminder {
  id             String          @id @default(uuid())
  appointmentId  String          @map("appointment_id")
  appointment    Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  channel        ReminderChannel @default(WHATSAPP)
  recipientPhone String          @map("recipient_phone") @db.VarChar(30)
  sentAt         DateTime        @default(now()) @map("sent_at")
  status         ReminderStatus  @default(PENDING)
  errorMessage   String?         @map("error_message") @db.Text
  templateKey    String?         @map("template_key") @db.VarChar(50)
  sentByUserId   String?         @map("sent_by_user_id")
  sentByUser     User?           @relation("ReminderSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([appointmentId, sentAt])
  @@index([status])
  @@map("appointment_reminders")
}

model InAppNotification {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  user          User             @relation("ReceivedNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  titleAr       String           @map("title_ar") @db.VarChar(150)
  titleEn       String           @map("title_en") @db.VarChar(150)
  bodyAr        String           @map("body_ar") @db.Text
  bodyEn        String           @map("body_en") @db.Text
  appointmentId String?          @map("appointment_id")
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patientId     String?          @map("patient_id")
  patient       Patient?         @relation(fields: [patientId], references: [id], onDelete: SetNull)
  isRead        Boolean          @default(false) @map("is_read")
  readAt        DateTime?        @map("read_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([userId, isRead, createdAt])
  @@map("in_app_notifications")
}

// ============================================================================
// 9. Packages & Financial Transactions (Slice D)
// ============================================================================

model Package {
  id                 String        @id @default(uuid())
  patientId          String        @map("patient_id")
  patient            Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  sessionTypeId      String        @map("session_type_id")
  sessionType        SessionType   @relation(fields: [sessionTypeId], references: [id], onDelete: Restrict)
  totalSessions      Int           @map("total_sessions") // e.g. 12
  totalPricePiasters Int           @map("total_price_piasters") // Integer piasters (R-0-4, R-7-1)
  startDate          DateTime      @map("start_date") @db.Date
  expiryDate         DateTime      @map("expiry_date") @db.Date // Default +60 days (R-2-6, R-7-1)
  status             PackageStatus @default(ACTIVE)
  notes              String?       @db.Text
  cancelledAt        DateTime?     @map("cancelled_at")
  cancellationReason String?       @map("cancellation_reason") @db.Text
  createdByUserId    String?       @map("created_by_user_id")
  createdByUser      User?         @relation("PackageCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId    String?       @map("updated_by_user_id")
  updatedByUser      User?         @relation("PackageUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  appointments Appointment[]
  charges      Charge[]
  extensions   PackageExtension[]
  priceChanges PriceChangeHistory[]

  @@index([patientId, status])
  @@index([expiryDate, status])
  @@map("packages")
}

model PackageExtension {
  id                 String   @id @default(uuid())
  packageId          String   @map("package_id")
  package            Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  previousExpiryDate DateTime @map("previous_expiry_date") @db.Date
  newExpiryDate      DateTime @map("new_expiry_date") @db.Date
  daysAdded          Int      @map("days_added") // 1..365 (R-7-6)
  reason             String   @db.Text // Mandatory audit reason (R-7-6)
  extendedByUserId   String   @map("extended_by_user_id")
  extendedByUser     User     @relation("PackageExtendedBy", fields: [extendedByUserId], references: [id], onDelete: Restrict)
  extendedAt         DateTime @default(now()) @map("extended_at")

  @@index([packageId])
  @@index([extendedByUserId])
  @@map("package_extensions")
}

model Charge {
  id              String       @id @default(uuid())
  patientId       String       @map("patient_id")
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  packageId       String?      @map("package_id")
  package         Package?     @relation(fields: [packageId], references: [id], onDelete: SetNull)
  appointmentId   String?      @map("appointment_id")
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  amountPiasters  Int          @map("amount_piasters") // Integer piasters (R-0-4, R-8.1-1)
  description     String       @db.VarChar(200)
  status          ChargeStatus @default(ACTIVE)
  createdByUserId String?      @map("created_by_user_id")
  createdByUser   User?        @relation("ChargeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  payments     Payment[]
  refunds      Refund[]
  writeOffs    WriteOff[]
  priceChanges PriceChangeHistory[]

  @@index([patientId, status])
  @@index([packageId])
  @@index([appointmentId])
  @@map("charges")
}

model Payment {
  id                String        @id @default(uuid())
  chargeId          String        @map("charge_id")
  charge            Charge        @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  receiptNumber     String        @unique @map("receipt_number") @db.VarChar(30) // INV-YYYY-00001 (R-8.2-2)
  receiptYear       Int           @map("receipt_year") // 2026 (Cairo local time, DEC-017)
  receiptSequence   Int           @map("receipt_sequence") // Sequential counter within year
  amountPiasters    Int           @map("amount_piasters") // Integer piasters > 0
  paymentMethod     PaymentMethod @map("payment_method")
  cashShiftId       String?       @map("cash_shift_id")
  cashShift         CashClosing?  @relation(fields: [cashShiftId], references: [id], onDelete: SetNull)
  isVoided          Boolean       @default(false) @map("is_voided")
  voidedAt          DateTime?     @map("voided_at")
  voidReason        String?       @map("void_reason") @db.Text
  voidedByUserId    String?       @map("voided_by_user_id")
  voidedByUser      User?         @relation("PaymentVoidedBy", fields: [voidedByUserId], references: [id], onDelete: SetNull)
  collectedByUserId String        @map("collected_by_user_id")
  collectedByUser   User          @relation("PaymentCollectedBy", fields: [collectedByUserId], references: [id], onDelete: Restrict)
  collectedAt       DateTime      @default(now()) @map("collected_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  refunds Refund[]

  @@index([chargeId, isVoided])
  @@index([collectedByUserId, collectedAt])
  @@index([cashShiftId])
  @@index([paymentMethod])
  @@map("payments")
}

model ReceiptCounter {
  id        String   @id @default(uuid())
  year      Int      @unique // Calendar year e.g. 2026
  lastValue Int      @default(0) @map("last_value") // Gapless annual sequential counter (DEC-017)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("receipt_counters")
}

model Refund {
  id                String        @id @default(uuid())
  chargeId          String        @map("charge_id")
  charge            Charge        @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  paymentId         String?       @map("payment_id")
  payment           Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amountPiasters    Int           @map("amount_piasters") // Integer piasters > 0 (R-0-4, R-8.3-2)
  refundMethod      PaymentMethod @map("refund_method") // Method refund paid out with
  handedOutByUserId String        @map("handed_out_by_user_id") // Cash drawer attribution (R-8.3-3, DEC-019)
  handedOutByUser   User          @relation("RefundHandedOutBy", fields: [handedOutByUserId], references: [id], onDelete: Restrict)
  cashShiftId       String?       @map("cash_shift_id")
  cashShift         CashClosing?  @relation(fields: [cashShiftId], references: [id], onDelete: SetNull)
  reason            String        @db.Text // Mandatory refund justification (R-8.3-2)
  approvedByUserId  String        @map("approved_by_user_id")
  approvedByUser    User          @relation("RefundApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  refundedAt        DateTime      @default(now()) @map("refunded_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([chargeId])
  @@index([handedOutByUserId])
  @@index([cashShiftId])
  @@map("refunds")
}

model WriteOff {
  id               String   @id @default(uuid())
  chargeId         String   @map("charge_id")
  charge           Charge   @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  amountPiasters   Int      @map("amount_piasters") // Amount written off in piasters (R-8.1-4)
  reason           String   @db.Text // Mandatory reason (R-8.1-4)
  approvedByUserId String   @map("approved_by_user_id")
  approvedByUser   User     @relation("WriteOffApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  writtenOffAt     DateTime @default(now()) @map("written_off_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([chargeId])
  @@map("write_offs")
}

model PriceChangeHistory {
  id                 String       @id @default(uuid())
  entityType         String       @map("entity_type") @db.VarChar(50) // APPOINTMENT, CHARGE, PACKAGE
  entityId           String       @map("entity_id") @db.VarChar(100)
  appointmentId      String?      @map("appointment_id")
  appointment        Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  chargeId           String?      @map("charge_id")
  charge             Charge?      @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  packageId          String?      @map("package_id")
  package            Package?     @relation(fields: [packageId], references: [id], onDelete: SetNull)
  oldPricePiasters   Int          @map("old_price_piasters")
  newPricePiasters   Int          @map("new_price_piasters")
  differencePiasters Int          @map("difference_piasters")
  reason             String       @db.Text // Mandatory audit explanation (R-5.1-2, R-8.3-4)
  changedByUserId    String       @map("changed_by_user_id")
  changedByUser      User         @relation("PriceChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)
  changedAt          DateTime     @default(now()) @map("changed_at")

  @@index([entityType, entityId])
  @@index([changedByUserId, changedAt])
  @@map("price_change_history")
}

model CashClosing {
  id                   String          @id @default(uuid())
  shiftNumber          Int             @map("shift_number")
  cashierUserId        String          @map("cashier_user_id")
  cashierUser          User            @relation("CashierClosings", fields: [cashierUserId], references: [id], onDelete: Restrict)
  openedAt             DateTime        @map("opened_at")
  closedAt             DateTime?       @map("closed_at")
  status               CashShiftStatus @default(OPEN)
  expectedCashPiasters Int             @default(0) @map("expected_cash_piasters") // Cash payments - Cash refunds - Cash expenses (R-8.4-1)
  countedCashPiasters  Int?            @map("counted_cash_piasters") // Cashier entered counted physical cash
  differencePiasters   Int?            @map("difference_piasters") // Counted - Expected
  closingNotes         String?         @map("closing_notes") @db.Text
  witnessUserId        String?         @map("witness_user_id")
  witnessUser          User?           @relation("WitnessClosings", fields: [witnessUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  payments Payment[]
  refunds  Refund[]

  @@index([cashierUserId, status])
  @@index([openedAt, closedAt])
  @@map("cash_closings")
}
